<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      BERN – Off-Grid Radio · Android permissions
      Minimum: Android 7.0 (API 24). Each block notes which Android versions use it.
    -->

    <!-- ── Bluetooth: Android 7.0 – 11 (API 24–30) ─────────────────────────
         Older Android uses the legacy Bluetooth permissions, and BLE scanning
         ALSO requires location permission (and Location switched on). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ── Bluetooth: Android 12+ (API 31+) ────────────────────────────────
         "Nearby devices" permissions. neverForLocation = we do NOT use Bluetooth
         scans to work out where the user is (GPS does that), so Android 12+
         does not need location just to find the radio. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ── Location: all versions ──────────────────────────────────────────
         Needed for BLE scanning on Android 7–11, and on every version for
         the map, location sharing and SOS coordinates. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── Notifications: Android 13+ (API 33+) ────────────────────────────
         Alerts for incoming messages and SOS. Ignored on older versions,
         where notifications are allowed by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Staying connected with the screen off ───────────────────────────
         FOREGROUND_SERVICE: Android 9+ (API 28+).
         The typed permissions below are required from Android 14 (API 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Features ────────────────────────────────────────────────────── -->
    <!-- Voice bursts -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- QR code to join a channel -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only used when signal IS available: downloading offline map areas.
         The app itself works fully without internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE is essential: hide the app on phones without it.
         Camera is optional: users can type an invite code instead. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!--
      SMS gateway mode (SEND_SMS / RECEIVE_SMS) is intentionally NOT declared here.
      Google Play restricts those permissions, so gateway mode will ship as a
      separate build flavor that is installed outside the Play Store.
    -->

    <application
        android:label="BERN Radio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The background radio service (foregroundServiceType="connectedDevice|location")
          is added in a later file, together with the Dart code that starts it.
        -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
